# ─── Application ─────────────────────────────────────────
APP_ENV=development           # development | staging | production
DEBUG=true
LOG_LEVEL=DEBUG               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console            # console (dev) | json (prod)

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/openskill
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Object Storage (MinIO / S3) ────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=openskill
S3_REGION=us-east-1

# ─── Frontend ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Backend's reference to the frontend origin (used in email links)
# Set to your public URL in production (e.g. https://app.example.com)
FRONTEND_URL=http://localhost:3000

# ─── API ────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
API_PREFIX=/api/v1

# ─── Auth / JWT ─────────────────────────────────────────
JWT_SECRET=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Generate for production: openssl rand -hex 32

# ─── LLM / AI Evaluation ──────────────────────────────
LLM_PROVIDER=anthropic            # anthropic | openai
LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
EVAL_MAX_CONCURRENT=10
EVAL_TIMEOUT_SECONDS=120
EVAL_MAX_RETRIES=3
