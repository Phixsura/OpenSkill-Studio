# Production compose environment — docs/ops/integration-fabric-operations.md §6c
#
#   cp .env.prod.example .env.prod
#   <fill every empty value>
#   docker compose --env-file .env.prod -f docker-compose.prod.yml config --quiet  # fails fast on anything missing
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# All empty values are REQUIRED: compose refuses to interpolate without them
# (${VAR:?...}), and the API's production boot validators additionally refuse
# defaults/weak values at startup (see §6c).

# ─── Database ────────────────────────────────────────────
DB_USER=openskill
# e.g. openssl rand -hex 24
DB_PASSWORD=
DB_NAME=openskill

# ─── Auth / JWT ──────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=

# ─── Credential encryption (webhook/connection secrets at rest) ──
# MUST be a real Fernet key, NOT a passphrase:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ─── Object storage (MinIO root + app credentials) ──────
# e.g. openssl rand -hex 16 / openssl rand -hex 24
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=openskill

# ─── Public origin ───────────────────────────────────────
# The browser-facing URL of the web app (CORS allow-origin + email links).
FRONTEND_URL=http://localhost:3000

# ─── Host ports ──────────────────────────────────────────
API_PORT=8000
WEB_PORT=3000
